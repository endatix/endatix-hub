# Environment
############################
# [REQUIRED] The base URL where the Endatix API is hosted, e.g. https://api.endatix.com
# 💡 TIP: Default value during development is https://localhost:5001
ENDATIX_BASE_URL=https://localhost:5001

# [OPTIONAL] API prefix path for the Endatix API (e.g., '/api', 'api', '/v1/api')
# Will be normalized to start with '/' and not end with '/'
# Defaults to "/api", so the final URL will be `${ENDATIX_BASE_URL}/api`
ENDATIX_API_PREFIX=/api

# [OPTIONAL] The hostnames of the remote (external) images that will be used to serve & optimize images. Provide multiple hostnames separated by commas.
REMOTE_IMAGE_HOSTNAMES=images.unsplash.com,images.pexels.com

# AUTH RELATED
############################
# [REQUIRED] The secret key that will be used to encrypt the Endatix Hub session cookie. Example: a28110cc8b94c5f3b3c923aa2c9fae4ed50c86ec61debfe6edb3c29947dbb00c
# 💡 TIP: You can use: `openssl rand -hex 32` to generate one
SESSION_SECRET=DbLkxcw0C5om6n2MFdn6E4sevnT8RzWqcdhQ1FUzhiQ6eGm

# [OPTIONAL] Sets the max age of a session in minutes. If not default value is used (30 days)
SESSION_MAX_AGE_IN_MINUTES=900

# [REQUIRED] The secret key used by Auth.js to encrypt/decrypt session data
# 💡 TIP: You can generate a secure AUTH_SECRET key using `npx auth secret` from the root of the Endatix Hub project
AUTH_SECRET=QKYuOMS2deIInJt9q6WNmWwuh9QtL7BPKKQfTG/KI48=

# [OPTIONAL] Needed for production deployment to ensure the authentication works correctly under reverse proxy - https://authjs.dev/getting-started/deployment 
AUTH_TRUST_HOST=true

# [OPTIONAL] Not required, but recommended when external auth providers are used. It helps the auth callbacks return to the correct domain under proxy, reverse proxy and other network setups. More info at https://authjs.dev/getting-started/deployment#auth_url
AUTH_URL=https://yourdomain.com

# Application Settings
############################

# [OPTIONAL] Application-level debug mode flag. Set to "true" to enable debug mode. If not set, defaults to development mode.
NEXT_PUBLIC_IS_DEBUG_MODE=false

# Data Collection
############################
# [OPTIONAL] The name of the cookie that will be used to store the form token. Falls back to "FPSK" if not set.
NEXT_FORMS_COOKIE_NAME=FPSK
# [OPTIONAL] The number of days the form token will be valid for. Falls back to 7 if not set.
NEXT_FORMS_COOKIE_DURATION_DAYS=7

# ReCaptcha
############################
# [OPTIONAL] The Google reCAPTCHA v3 Site Key for client side integration
# 💡 TIP: You can obtain the key and learn more at https://developers.google.com/recaptcha/docs/v3
# Example: 4LcsG3UfAAAaAF5HQnF5IijKep9PwZbMYo0y_Igt
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Slack
############################
# [OPTIONAL] Slack client id. Optional if you don't want to use Slack.
SLACK_CLIENT_ID=
# [OPTIONAL] Slack client secret. Optional if you don't want to use Slack.
SLACK_CLIENT_SECRET=
# [OPTIONAL] Slack redirect uri. Optional if you don't want to use Slack.
SLACK_REDIRECT_URI=

# Storage: General
############################
# [REQUIRED for blob storage] azure | s3 | none. No auto-detection from credentials alone.
STORAGE_PROVIDER=none
# [OPTIONAL] Set to "false" only when storage objects should be public. Defaults to true.
STORAGE_IS_PRIVATE=true
# [OPTIONAL] Storage container/bucket name for user uploaded files. Defaults to user-files.
STORAGE_USER_FILES_CONTAINER_NAME=user-files
# [OPTIONAL] Storage container/bucket name for content files uploaded by Endatix users. Defaults to content.
STORAGE_CONTENT_FILES_CONTAINER_NAME=content

# Storage: S3-compatible (RustFS)
# ------------------------
# See https://docs.rustfs.com/developer/sdk/javascript.html — path-style addressing must stay on (`STORAGE_S3_FORCE_PATH_STYLE` default).
# [OPTIONAL] Browser-reachable RustFS / MinIO endpoint origin, e.g. http://192.168.1.100:9000
STORAGE_S3_ENDPOINT=
# [OPTIONAL] S3 access key id (RustFS IAM access key)
STORAGE_S3_ACCESS_KEY_ID=
# [OPTIONAL] S3 secret access key
STORAGE_S3_SECRET_ACCESS_KEY=
# [OPTIONAL] Region string for SigV4 (RustFS accepts arbitrary values; default us-east-1)
STORAGE_S3_REGION=us-east-1
# [OPTIONAL] Set to "false" only if your backend is virtual-hosted-style and does not need path-style (RustFS requires path-style = leave unset)
STORAGE_S3_FORCE_PATH_STYLE=
# [OPTIONAL] Presigned GET expiry in minutes. Default 15
STORAGE_S3_READ_EXPIRY_MINUTES=
# [OPTIONAL] Presigned PUT expiry in seconds. Default 180
STORAGE_S3_WRITE_EXPIRY_SECONDS=

# Storage: Azure BLOB
# ------------------------
# [OPTIONAL] Azure storage account name. Optional if you don't want to use Azure Blob Storage.
STORAGE_AZURE_ACCOUNT_NAME=
# [OPTIONAL] Azure storage account key. Optional if you don't want to use Azure Blob Storage.
STORAGE_AZURE_ACCOUNT_KEY=
# [REQUIRED when STORAGE_PROVIDER=azure] Browser-reachable Blob endpoint:
# default account endpoint (https://myaccount.blob.core.windows.net) or a custom routed endpoint/CDN/AFD that forwards Blob REST methods used by Hub.
STORAGE_AZURE_ENDPOINT=
# [OPTIONAL] Set the default duration in minutes for Azure SAS tokens with read access. Defaults to 15 minutes
STORAGE_AZURE_SAS_READ_EXPIRY_MINUTES=
# [OPTIONAL] Set the default duration in seconds for Azure SAS tokens with write access. Defaults to 180 seconds
STORAGE_AZURE_SAS_WRITE_EXPIRY_SECONDS=

# Storage: Azure legacy fallbacks
# ------------------------
# Existing Azure deployments may keep using AZURE_STORAGE_* while migrating.
# STORAGE_IS_PRIVATE and STORAGE_AZURE_* values take precedence when both are set.
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_CUSTOM_DOMAIN=
# AZURE_STORAGE_IS_PRIVATE=


# Image Resize
############################
# [OPTIONAL] Whether to resize images.
RESIZE_IMAGES=false
# [OPTIONAL] The width to resize images to.
RESIZE_IMAGES_WIDTH=800

# Telemetry
############################
# [OPTIONAL] OpenTelemetry log level. Set to true to enable logging.
OTEL_LOG_LEVEL=
# [OPTIONAL] Azure Application Insights connection string for server-side telemetry.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# PostHog
############################
# [OPTIONAL] PostHog API key for client-side analytics tracking.
NEXT_PUBLIC_POSTHOG_KEY=
# [OPTIONAL] PostHog API host URL. Default: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# [OPTIONAL] PostHog UI host URL for linking directly to the PostHog UI.
NEXT_PUBLIC_POSTHOG_UI_HOST=
# [OPTIONAL] Use this to enable PostHog as a feature flag adapter (provider). true to enable
ENABLE_POSTHOG_ADAPTER=

# Public
############################
# [OPTIONAL] SLK.
NEXT_PUBLIC_SLK=

# [OPTIONAL] Public name for the application.
NEXT_PUBLIC_NAME=

# SEO
############################
# [OPTIONAL] List of allowed domains with app.endatix.com robots.txt behavior (User-agent: *, Allow: /login, Disallow: /). Comma-separated list.
ROBOTS_ALLOWED_DOMAINS=app.endatix.com

# Maintenance
############################
# [OPTIONAL] Set to true to enable maintenance mode.
MAINTENANCE_MODE=false
# [OPTIONAL] The retry after seconds for the maintenance mode.
MAINTENANCE_RETRY_AFTER_SECONDS=600

# Override if you want different text on the maintenance page. Default values are on lib/maintenance/maintenance-config.ts

# [OPTIONAL] The badge label for the maintenance mode.
MAINTENANCE_BADGE_LABEL=
# [OPTIONAL] The title for the maintenance mode.
MAINTENANCE_TITLE=
# [OPTIONAL] The card description for the maintenance mode.
MAINTENANCE_CARD_DESCRIPTION=
# [OPTIONAL] Main body copy on the maintenance page.
MAINTENANCE_BODY=
# [OPTIONAL] Footer line on the maintenance page.
MAINTENANCE_FOOTER=
# [OPTIONAL] HTML document title while maintenance mode is on.
MAINTENANCE_METADATA_TITLE=
# [OPTIONAL] Meta description for the maintenance page.
MAINTENANCE_METADATA_DESCRIPTION=
