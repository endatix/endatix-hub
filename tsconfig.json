{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@endatix/storage-core": [
        "./features/asset-storage/infrastructure/core/index.ts"
      ],
      "@endatix/storage-azure": [
        "./features/asset-storage/infrastructure/providers/azure/index.ts"
      ],
      "@endatix/storage-s3": [
        "./features/asset-storage/infrastructure/providers/s3/index.ts"
      ]
    },
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "docs", "examples"]
}
