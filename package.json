{
  "name": "endatix-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm discover-questions && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "dev-https": "pnpm dev --experimental-https",
    "dev:inspect": "pnpm discover-questions && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS='--inspect' next dev",
    "build": "pnpm discover-questions && next build",
    "build:standalone": "pnpm build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "run:standalone": "pnpm build:standalone && NODE_TLS_REJECT_UNAUTHORIZED=0 node .next/standalone/server.js --trace-warnings",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:debug": "playwright test --debug",
    "discover-questions": "node scripts/discover-questions.mjs",
    "pnpm:comments": "node scripts/echo-pnpm-comments.mjs",
    "tools:upgrade-surveyjs": "node scripts/upgrade-surveyjs.mjs"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.16.0",
    "@azure/storage-blob": "^12.31.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flags-sdk/posthog": "^0.2.2",
    "@grpc/grpc-js": "^1.13.4",
    "@hookform/resolvers": "^3.10.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.203.0",
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.203.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.203.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/instrumentation-fetch": "^0.203.0",
    "@opentelemetry/instrumentation-http": "^0.203.0",
    "@opentelemetry/otlp-exporter-base": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-logs": "^0.203.0",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@react-pdf/renderer": "^4.3.1",
    "@swc/helpers": "^0.5.15",
    "@tanstack/react-table": "^8.20.6",
    "@vercel/functions": "^1.5.2",
    "ace-builds": "^1.43.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "flags": "^4.0.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.574.0",
    "markdown-it": "^14.1.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.347.1",
    "posthog-node": "^5.24.15",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.2",
    "react-quill-new": "^3.8.3",
    "react-resizable-panels": "^4.6.4",
    "sanitize-html": "^2.17.0",
    "semver": "^7.6.3",
    "sharp": "^0.34.2",
    "sonner": "^1.7.1",
    "survey-analytics": "^2.5.9",
    "survey-core": "^2.5.12",
    "survey-creator-core": "^2.5.12",
    "survey-creator-react": "^2.5.12",
    "survey-react-ui": "^2.5.12",
    "tailwind-merge": "^3.4.1",
    "uuid": "^11.0.5",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.12",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "babel-plugin-react-compiler": "0.0.0-experimental-6067d4e-20240919",
    "cross-env": "^7.0.3",
    "eslint": "^10.0.3",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-testing-library": "^7.15.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.83.1",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "pnpm": ">=9.0.0 <=10.30.2",
    "node": ">=20.9.0 <25.1.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.3",
      "glob": "10.5.0",
      "vite": "^7.1.11",
      "preact": "10.27.3",
      "fast-xml-parser": "^5.3.4",
      "lodash": "^4.17.23",
      "lodash-es": "^4.17.23",
      "axios": "^1.13.5",
      "minimatch": "^10.2.1",
      "rollup": "^4.59.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "core-js",
      "esbuild",
      "msw",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "comments": {
      "overrides": "[@types/react] & [@types/react-dom] are managed by Next.js. |  [glob] 10.5.0 bump is to address CVE-2025-64756. Remove with vitest 4x | [vite] 7.1.11 bump is to address CVE-2025-62522. Remove with vitest 4x | [preact] 10.27.3 bump is to address CVE-2026-22028. Remove with better auth and next posthog-js bump | [fast-xml-parser] 5.3.4 bump is to address CVE-2026-25128. Remove once we upgrade @azure/storage-blob | [lodash] 4.17.23 bump is to address CVE-2025-13465. Multiple peer dependenices hold outdated versions | [lodash-es] 4.17.23 bump is to address CVE-2025-13465. Fix with quill & react-quill-new bump | [axios] 1.13.5 bump is to address CVE-2026-25639. Remove when @flags-sdk/posthog is updated | [minimatch] 10.2.1 bump is to address CVE-2026-26996. Multiple peer dependenices hold outdated versions | [rollup] 4.59.0 bump is to address CVE-2026-27606. Remove with vitest 4x"
    }
  }
}
