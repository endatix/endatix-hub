{
  "name": "endatix-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-embed.mjs",
    "dev": "pnpm discover-questions && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "dev-https": "pnpm dev --experimental-https",
    "dev:inspect": "pnpm discover-questions && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_OPTIONS='--inspect' next dev",
    "prebuild": "pnpm build:embed && pnpm discover-questions",
    "build:embed": "node scripts/build-embed.mjs",
    "dev:embed": "node scripts/build-embed.mjs --watch",
    "build": "next build",
    "build:standalone": "pnpm build && node scripts/copy-standalone.mjs",
    "run:standalone": "pnpm build:standalone && cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 node --trace-warnings .next/standalone/server.js",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=smoke-tests",
    "test:e2e:debug": "playwright test --debug",
    "discover-questions": "node scripts/discover-questions.mjs",
    "tools:upgrade-surveyjs": "node scripts/upgrade-surveyjs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@azure/monitor-opentelemetry": "^1.18.2",
    "@azure/storage-blob": "^12.31.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flags-sdk/posthog": "^1.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@hookform/resolvers": "^3.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-fetch": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/otlp-exporter-base": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-pdf/renderer": "^4.3.1",
    "@swc/helpers": "^0.5.15",
    "@tanstack/react-table": "^8.20.6",
    "@vercel/functions": "^3.9.7",
    "ace-builds": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "fflate": "^0.8.3",
    "flags": "^4.2.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.574.0",
    "markdown-it": "^14.3.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.407.3",
    "posthog-node": "5.45.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.54.2",
    "react-quill-new": "^3.8.3",
    "react-resizable-panels": "^4.6.4",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.17.4",
    "semver": "^7.6.3",
    "sharp": "^0.35.3",
    "sonner": "^1.7.1",
    "survey-analytics": "^3.0.2",
    "survey-core": "^3.0.2",
    "survey-creator-core": "^3.0.2",
    "survey-creator-react": "^3.0.2",
    "survey-react-ui": "^3.0.2",
    "tailwind-merge": "^3.4.1",
    "uuid": "^11.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.83.1",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "pnpm": ">=10.34.5 <11.0.0 || >=11.11.0 <13.0.0",
    "node": ">=22.13.0 <23.0.0 || >=24.0.0 <25.0.0"
  }
}
