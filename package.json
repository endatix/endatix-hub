    "semver": "^7.6.3",
    "sharp": "^0.34.2",
    "sonner": "^1.7.1",
    "survey-analytics": "^2.5.18",
    "survey-core": "^2.5.18",
    "survey-creator-core": "^2.5.18",
    "survey-creator-react": "^2.5.18",
    "survey-react-ui": "^2.5.18",
    "tailwind-merge": "^3.4.1",
