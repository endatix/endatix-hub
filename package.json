    "@opentelemetry/instrumentation-http": "^0.301.0",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/otlp-grpc-exporter-base": "^0.301.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@react-pdf/renderer": "4.9.0",
    "@swc/helpers": "^0.5.24",
    "@tanstack/react-table": "^8.20.6",
    "@vercel/functions": "^1.5.2",
    "ace-builds": "^1.45.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "entities": "^7",
    "fflate": "^0.8.3",
    "flags": "^4.4.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "markdown-it": "^15.0.3",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.447.3",
    "posthog-node": "5.63.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-quill-new": "^3.8.3",
    "react-resizable-panels": "^4.19.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "sonner": "^1.7.1",
    "survey-analytics": "^3.2.4",
