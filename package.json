{
  "name": "endatix-hub",
  "version": "0.0.0-local",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev-https": "node scripts/dev.mjs --experimental-https",
    "setup:dev": "node scripts/with-dev-cert.mjs --export",
    "dev:inspect": "node scripts/dev.mjs --inspect",
    "prebuild": "pnpm build:embed && pnpm discover-questions",
    "build:embed": "node scripts/build-embed.mjs",
    "dev:embed": "node scripts/build-embed.mjs --watch",
    "build": "next build && node scripts/check-linked-externals.mjs",
    "build:standalone": "pnpm build && node scripts/copy-standalone.mjs",
    "check:runtime-storage": "node scripts/check-runtime-storage.mjs",
    "check:dereferenced-standalone": "node scripts/check-dereferenced-standalone.mjs",
    "run:standalone": "pnpm build:standalone && node scripts/with-dev-cert.mjs node --trace-warnings .next/standalone/server.js",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc -p tsconfig.vitest.json --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/with-dev-cert.mjs playwright test",
    "test:e2e:ui": "node scripts/with-dev-cert.mjs playwright test --ui",
    "test:e2e:smoke": "node scripts/with-dev-cert.mjs playwright test --project=smoke-tests",
    "test:e2e:debug": "node scripts/with-dev-cert.mjs playwright test --debug",
    "discover-questions": "node scripts/discover-questions.mjs",
    "tools:upgrade-surveyjs": "node scripts/upgrade-surveyjs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.45",
    "@azure/storage-blob": "^12.34.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@flags-sdk/posthog": "^1.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.301.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
