{
  "title": "{city}",
  "pages": [
    {
      "name": "page1",
      "elements": [
        {
          "type": "text",
          "name": "familySize",
          "title": "Family size",
          "defaultValueExpression": "{family_size}"
        },
        {
          "type": "text",
          "name": "ageInMonths",
          "title": "Age in months",
          "defaultValueExpression": "{age} * 12"
        },
        {
          "type": "text",
          "name": "olderAdult",
          "title": "Shown when age is at least 50",
          "visibleIf": "{age} >= 50"
        }
      ]
    }
  ]
}
